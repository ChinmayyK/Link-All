<?xml version="1.0" encoding="utf-8"?>
<!--
  Connected computers appear as Direct Share targets in Android's share sheet
  (published by DeviceShareTargets). Files only: shared text has no way to
  reach a single device and keeps going through Link All itself.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="app.linkall.LinkAllShareTarget">
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <data android:mimeType="audio/*" />
        <data android:mimeType="application/*" />
        <category android:name="app.linkall.category.SEND_TO_DEVICE" />
    </share-target>
</shortcuts>
