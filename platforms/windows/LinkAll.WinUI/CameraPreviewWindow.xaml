<Window
    x:Class="LinkAll.WinUI.CameraPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Camera">

    <!--
        Continuity camera preview. A panel with a row-style header (icon
        well, title, one line of detail, close) above a black letterbox that
        holds the stream and the waiting/ended status.
    -->
    <Grid Background="Transparent">
        <Border x:Name="AppTitleBar" Height="1" VerticalAlignment="Top" Background="Transparent" />

        <Border Style="{StaticResource AppCardLarge}" Margin="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="16,12,12,12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AppIconTile}"
                            Background="{ThemeResource AppAccentSubtleBrush}"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE722;" FontSize="16"
                                  Foreground="{ThemeResource AppAccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Continuity camera"
                                   Style="{StaticResource AppBodyStrong}" />
                        <TextBlock Text="Live from a paired device"
                                   Style="{StaticResource AppSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource AppIconButton}"
                            VerticalAlignment="Center"
                            Click="BtnClose_Click"
                            ToolTipService.ToolTip="Close"
                            AutomationProperties.Name="Close the camera preview">
                        <FontIcon Glyph="&#xE711;" FontSize="13" />
                    </Button>
                </Grid>

                <!-- Black letterbox is intentional in both themes, as in a media player. -->
                <Border Grid.Row="1" Margin="12,0,12,12"
                        CornerRadius="{StaticResource RadiusCard}"
                        Background="Black">
                    <Grid>
                        <Image x:Name="CameraImage" Stretch="Uniform" />
                        <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressRing IsActive="True" Width="24" Height="24" Foreground="White" />
                            <TextBlock x:Name="StatusText" Text="Waiting for the camera stream"
                                       Foreground="{ThemeResource AppScrimTextSecondaryBrush}"
                                       FontFamily="{StaticResource AppTextFont}"
                                       FontSize="13"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
