<!--
    Link All design tokens.

    Shared visual language with the Android app: one cobalt accent (the
    Mac app's brand blue, #2F5BFF), neutral surfaces, lists grouped by
    hairlines, and pill-shaped buttons. The retired violet/cyan accents now
    resolve to the single accent so nothing introduces a second hue.

    This is the single source of truth for colour, elevation, typography
    metrics, and radii. Two rules keep it honest:

      1. Anything that differs between light and dark lives in a
         ThemeDictionary and MUST be consumed with {ThemeResource ...}.
         {StaticResource ...} freezes at parse time and leaves stale colours
         after ThemeService flips a window's RequestedTheme at runtime.
      2. Anything theme-independent (fonts, radii, sizes) lives at the
         bottom and is consumed with {StaticResource ...}.

    We also re-point the WinUI *system* accent ramp (SystemAccentColor and
    its Light/Dark variants) at Link All's accent. Every stock control -
    ToggleSwitch, ProgressBar, RadioButton, CheckBox, NavigationView's
    selection indicator, ContentDialog's primary button, text-box focus
    underline - derives its accent from that ramp, so one override keeps the
    entire app coherent instead of us re-skinning controls one at a time.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ================================================== LIGHT -->
        <ResourceDictionary x:Key="Light">
            <!-- The brand mark in the title bar: the light logo on the light theme. -->

            <!-- System accent ramp. Light-theme accent *fills* resolve to
                 SystemAccentColorDark1, so that entry carries the brand
                 colour and the Light* entries are the tint ramp. -->
            <Color x:Key="SystemAccentColor">#2F5BFF</Color>
            <Color x:Key="SystemAccentColorDark1">#2F5BFF</Color>
            <Color x:Key="SystemAccentColorDark2">#2449D9</Color>
            <Color x:Key="SystemAccentColorDark3">#1D3BB5</Color>
            <Color x:Key="SystemAccentColorLight1">#6F8CFF</Color>
            <Color x:Key="SystemAccentColorLight2">#6699E3</Color>
            <Color x:Key="SystemAccentColorLight3">#99BBEE</Color>

            <!-- Brand accent -->
            <Color x:Key="AppAccentColor">#2F5BFF</Color>
            <SolidColorBrush x:Key="AppAccentBrush" Color="#2F5BFF" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#2449D9" />
            <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#1D3BB5" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#142F5BFF" />
            <SolidColorBrush x:Key="AppAccentSubtleHoverBrush" Color="#222F5BFF" />
            <SolidColorBrush x:Key="AppAccentBorderBrush" Color="#402F5BFF" />
            <!-- Legacy alias: was a second, competing purple accent. Now a
                 tint of the single brand accent so old surfaces stop
                 introducing a rogue hue. -->
            <SolidColorBrush x:Key="AppAccentLightBrush" Color="#6F8CFF" />

            <!-- Text/iconography that sits on top of a saturated fill -->
            <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FFFFFF" />

            <!-- Status. One muted-but-legible value per state; these are
                 also mirrored as literal hex in LinkAllStore's *Color
                 view-model properties, which are theme-independent. -->
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="AppSuccessSubtleBrush" Color="#1416A34A" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#B7791F" />
            <SolidColorBrush x:Key="AppWarningSubtleBrush" Color="#16B7791F" />
            <SolidColorBrush x:Key="AppWarningBorderBrush" Color="#40B7791F" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="AppDangerHoverBrush" Color="#B91C1C" />
            <SolidColorBrush x:Key="AppDangerSubtleBrush" Color="#14DC2626" />
            <SolidColorBrush x:Key="AppDangerSubtleHoverBrush" Color="#24DC2626" />
            <SolidColorBrush x:Key="AppNeutralBrush" Color="#6B665E" />

            <!-- Retired secondary accents. Kept so legacy surfaces still
                 resolve, retuned so they read as quiet neighbours of the
                 brand accent rather than competing hues. -->
            <SolidColorBrush x:Key="AppVioletBrush" Color="#2F5BFF" />
            <SolidColorBrush x:Key="AppVioletSubtleBrush" Color="#142F5BFF" />
            <Color x:Key="AppCyanColor">#2F5BFF</Color>
            <SolidColorBrush x:Key="AppCyanBrush" Color="#2F5BFF" />
            <SolidColorBrush x:Key="AppCyanSubtleBrush" Color="#142F5BFF" />

            <!--
                Surface ladder, background -> foreground:

                  Sidebar     transparent, so the window's Mica shows through
                  Canvas      the solid content pane the pages scroll inside
                  Surface     cards and rows sitting on the canvas
                  Elevated    flyouts, dialogs, popups
                  Subtle      recessed fills (track backgrounds, chips)
            -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FAF8F5" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="#FFFFFF" />
            <!-- Every ContentDialog: the app's raised surface and a quiet footer. -->
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#E7E2DA" />
            <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#001B1A17" />
            <SolidColorBrush x:Key="AppSurfaceSubtleBrush" Color="#F2EFEA" />
            <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="#0A1B1A17" />
            <SolidColorBrush x:Key="AppSurfacePressedBrush" Color="#141B1A17" />
            <SolidColorBrush x:Key="AppSurfaceSelectedBrush" Color="#0F2F5BFF" />

            <!-- Opaque control fills. Buttons and chips sit on an opaque
                 card, so their hover/press states have to be real colours -
                 a translucent black overlay would read as a smudge. -->
            <SolidColorBrush x:Key="AppControlFillBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppControlFillHoverBrush" Color="#F2EFEA" />
            <SolidColorBrush x:Key="AppControlFillPressedBrush" Color="#E7E2DA" />

            <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#E7E2DA" />
            <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#D8D2C8" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#E7E2DA" />

            <!-- The pane reads as Mica; keep it transparent rather than
                 painting a near-white slab over the backdrop. -->
            <SolidColorBrush x:Key="SidebarAcrylicBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ModalAcrylicBrush" Color="#FFFFFF" />

            <!-- Stock-control lightweight styling. These are documented WinUI
                 resource keys; overriding them here restyles every instance
                 of the control without retemplating it. -->
            <!-- Sidebar selection: an accent-tinted fill with accent text and
                 icon, no stock indicator bar. -->
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#142F5BFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#1C2F5BFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#242F5BFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#2F5BFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#2F5BFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#2F5BFF" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0A1B1A17" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#141B1A17" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />

            <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D8D2C8" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#BDB6AA" />

            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#081B1A17" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#121B1A17" />

            <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#221B1A17" />
        </ResourceDictionary>

        <!-- =================================================== DARK -->
        <ResourceDictionary x:Key="Dark">

            <!-- Dark-theme accent *fills* resolve to SystemAccentColorLight2,
                 which is intentionally light: WinUI pairs it with near-black
                 foreground text (TextOnAccentFillColorPrimary). Our own
                 AppAccentBrush/AppOnAccentBrush pair follows the same rule so
                 custom and stock controls match. -->
            <Color x:Key="SystemAccentColor">#3D7BEF</Color>
            <Color x:Key="SystemAccentColorDark1">#3068D6</Color>
            <Color x:Key="SystemAccentColorDark2">#2858B8</Color>
            <Color x:Key="SystemAccentColorDark3">#204794</Color>
            <Color x:Key="SystemAccentColorLight1">#4A88F7</Color>
            <Color x:Key="SystemAccentColorLight2">#7C9BFF</Color>
            <Color x:Key="SystemAccentColorLight3">#A8BEFF</Color>

            <Color x:Key="AppAccentColor">#7C9BFF</Color>
            <SolidColorBrush x:Key="AppAccentBrush" Color="#7C9BFF" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#93AEFF" />
            <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#6385F0" />
            <SolidColorBrush x:Key="AppAccentSubtleBrush" Color="#247C9BFF" />
            <SolidColorBrush x:Key="AppAccentSubtleHoverBrush" Color="#347C9BFF" />
            <SolidColorBrush x:Key="AppAccentBorderBrush" Color="#557C9BFF" />
            <SolidColorBrush x:Key="AppAccentLightBrush" Color="#A8BEFF" />

            <SolidColorBrush x:Key="AppOnAccentBrush" Color="#0B1022" />

            <SolidColorBrush x:Key="AppSuccessBrush" Color="#34D399" />
            <SolidColorBrush x:Key="AppSuccessSubtleBrush" Color="#2434D399" />
            <!-- Desaturated toward the app's cool dark palette (was #EAB055,
                 a bright warm gold that read as an unrelated yellow "sticker"
                 against the surrounding blue/graphite dark theme, most
                 visible on the pairing-request card which uses this color
                 across its left stripe, icon, and border all at once). -->
            <SolidColorBrush x:Key="AppWarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="AppWarningSubtleBrush" Color="#24FBBF24" />
            <SolidColorBrush x:Key="AppWarningBorderBrush" Color="#4DFBBF24" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#F87171" />
            <SolidColorBrush x:Key="AppDangerHoverBrush" Color="#FCA5A5" />
            <SolidColorBrush x:Key="AppDangerSubtleBrush" Color="#24F87171" />
            <SolidColorBrush x:Key="AppDangerSubtleHoverBrush" Color="#36F87171" />
            <SolidColorBrush x:Key="AppNeutralBrush" Color="#A19D95" />

            <SolidColorBrush x:Key="AppVioletBrush" Color="#7C9BFF" />
            <SolidColorBrush x:Key="AppVioletSubtleBrush" Color="#247C9BFF" />
            <Color x:Key="AppCyanColor">#7C9BFF</Color>
            <SolidColorBrush x:Key="AppCyanBrush" Color="#7C9BFF" />
            <SolidColorBrush x:Key="AppCyanSubtleBrush" Color="#247C9BFF" />

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F1012" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#17181B" />
            <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="#1D1E22" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#141517" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#141517" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#2A2B30" />
            <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#001B1A17" />
            <SolidColorBrush x:Key="AppSurfaceSubtleBrush" Color="#1D1E22" />
            <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="#0FF1EFEA" />
            <SolidColorBrush x:Key="AppSurfacePressedBrush" Color="#1AF1EFEA" />
            <SolidColorBrush x:Key="AppSurfaceSelectedBrush" Color="#227C9BFF" />

            <SolidColorBrush x:Key="AppControlFillBrush" Color="#1D1E22" />
            <SolidColorBrush x:Key="AppControlFillHoverBrush" Color="#26272B" />
            <SolidColorBrush x:Key="AppControlFillPressedBrush" Color="#303137" />

            <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#2A2B30" />
            <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#3A3B41" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#2A2B30" />

            <SolidColorBrush x:Key="SidebarAcrylicBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ModalAcrylicBrush" Color="#1D1E22" />

            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#267C9BFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#307C9BFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#3A7C9BFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#7C9BFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#7C9BFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#7C9BFF" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0FF1EFEA" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#1AF1EFEA" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />

            <SolidColorBrush x:Key="TextControlBackground" Color="#141517" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#17181B" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1D1E22" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#26F1EFEA" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#38F1EFEA" />

            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0BF1EFEA" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#16F1EFEA" />

            <SolidColorBrush x:Key="ToolTipBackground" Color="#1D1E22" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#26F1EFEA" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ======================================== THEME-INDEPENDENT -->

    <!-- Overlay scrims and the "glass HUD" tokens for transient surfaces
         (drop targets, edge sliver) that float over arbitrary desktop
         content rather than app content. These stay dark-glass in both
         themes on purpose - they have to read against whatever is behind
         the window, not against our own canvas. -->
    <SolidColorBrush x:Key="AppScrimBrush" Color="#401B1A17" />
    <SolidColorBrush x:Key="AppScrimStrongBrush" Color="#801B1A17" />
    <SolidColorBrush x:Key="AppScrimBorderBrush" Color="#40F1EFEA" />
    <SolidColorBrush x:Key="AppScrimSubtleBrush" Color="#1AF1EFEA" />
    <SolidColorBrush x:Key="AppScrimTextSecondaryBrush" Color="#8CF1EFEA" />

    <!-- Typography. Segoe UI Variable is the Windows 11 system family;
         Display is optically sized for headings, Text for body copy. Both
         fall back to Segoe UI on Windows 10. -->
    <FontFamily x:Key="AppDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="AppTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="AppSmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>
    <FontFamily x:Key="AppMonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Radius scale, assigned by hierarchy rather than by taste:
         controls stay tight, containers get progressively softer. -->
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">20</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <!-- Buttons and chips: a soft rounded rectangle, same radius as inputs. -->
    <CornerRadius x:Key="RadiusButton">8</CornerRadius>

    <!-- Global control radii: two overrides that modernise every stock
         control and popup in one shot. -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>

    <!-- Spacing scale: 4 / 8 / 12 / 16 / 20 / 24 / 32 / 40.
         Exposed as Thickness tokens for the values that repeat most, so
         padding stays on the scale instead of drifting into 18s and 14s. -->
    <Thickness x:Key="PagePadding">28,18,28,32</Thickness>
    <Thickness x:Key="CardPadding">18</Thickness>
    <Thickness x:Key="CardPaddingCompact">14,12</Thickness>
    <Thickness x:Key="RowPadding">14,10</Thickness>
</ResourceDictionary>
