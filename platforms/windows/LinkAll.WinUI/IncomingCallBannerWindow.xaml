<Window
    x:Class="LinkAll.WinUI.IncomingCallBannerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:LinkAll.WinUI.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Incoming call">

    <!--
        Call banner for the paired phone, laid out as a single list row: an initials
        well, caller and the call state, then round Decline (or End) and Answer
        buttons built on the shared pill styles.
    -->
    <Grid Background="Transparent">
        <Border x:Name="AppTitleBar" Height="1" VerticalAlignment="Top" Background="Transparent" />

        <Border Style="{StaticResource AppCardLarge}"
                Margin="8"
                Padding="{StaticResource RowPadding}"
                VerticalAlignment="Center">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AppIconTile}"
                        Background="{ThemeResource AppAccentSubtleBrush}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtInitials" Text="D"
                               Foreground="{ThemeResource AppAccentBrush}"
                               FontFamily="{StaticResource AppDisplayFont}"
                               FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="TxtCallerName" Text="Incoming call"
                               Style="{StaticResource AppBodyStrong}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TxtDetail" Text="Incoming call"
                               Style="{StaticResource AppSecondary}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Button x:Name="BtnDecline"
                            Style="{StaticResource AppDestructiveButton}"
                            Width="40" Height="40" MinHeight="0" Padding="0"
                            Click="BtnDecline_Click"
                            ToolTipService.ToolTip="Decline"
                            AutomationProperties.Name="Decline the call">
                        <FontIcon Glyph="&#xE778;" FontSize="15" />
                    </Button>
                    <Button x:Name="BtnAccept"
                            Style="{StaticResource AppPrimaryButton}"
                            Width="40" Height="40" MinHeight="0" Padding="0"
                            Click="BtnAccept_Click"
                            ToolTipService.ToolTip="Answer on phone"
                            AutomationProperties.Name="Answer the call on your phone">
                        <FontIcon Glyph="&#xE717;" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
