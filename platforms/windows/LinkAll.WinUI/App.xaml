<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LinkAll.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkAll.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                Load order matters: XamlControlsResources first (it defines
                the stock control styles our overrides refine), then the
                design tokens, then the control library that consumes them.
            -->
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Theme/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One look for every ContentDialog, XAML or code: rounder, roomier. -->
            <Style x:Key="AppDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="24,22,24,20" />
            </Style>
            <Style TargetType="ContentDialog" BasedOn="{StaticResource AppDialogStyle}" />

            <!-- Global Converters -->
            <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
            <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <local:MultiplyConverter x:Key="MultiplyConverter"/>
            <local:BoolToFolderIconConverter x:Key="BoolToFolderIconConverter"/>
            <local:BoolToItemCountDotConverter x:Key="BoolToItemCountDotConverter"/>
            <local:ItemCountTextConverter x:Key="ItemCountTextConverter"/>
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <local:InverseCountToVisibilityConverter x:Key="InverseCountToVisibilityConverter"/>
            <local:PlatformToGlyphConverter x:Key="PlatformToGlyphConverter"/>
            <local:BatteryGlyphConverter x:Key="BatteryGlyphConverter"/>
            <local:NetworkTypeToGlyphConverter x:Key="NetworkTypeToGlyphConverter"/>
            <local:FileTypeToGlyphConverter x:Key="FileTypeToGlyphConverter"/>
            <local:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
            <local:StringToBrushConverter x:Key="StringToBrushConverter"/>
            <local:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
            <local:ActivityKindToGlyphConverter x:Key="ActivityKindToGlyphConverter"/>
            <local:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
