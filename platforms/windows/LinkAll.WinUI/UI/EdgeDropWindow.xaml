<Window
    x:Class="LinkAll.WinUI.UI.EdgeDropWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Edge drop">

    <!--
        Screen-edge drop target. At rest it is a thin accent bar against the
        screen edge; while a drag hovers, code-behind widens the window and
        shows ExpandedCard, a dark-glass panel (AppScrim* tokens) with an
        icon well and two lines of copy.
    -->
    <Grid Background="Transparent" AllowDrop="True"
          DragEnter="Grid_DragEnter" DragLeave="Grid_DragLeave" Drop="Grid_Drop">

        <Border x:Name="AppTitleBar" Height="1" VerticalAlignment="Top" Background="Transparent" />

        <Border x:Name="RestingSliver"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                CornerRadius="3"
                Margin="0,0,4,0"
                Width="6" Height="96"
                Background="{ThemeResource AppAccentBrush}" />

        <Border x:Name="ExpandedCard"
                CornerRadius="{StaticResource RadiusLarge}"
                BorderBrush="{ThemeResource AppScrimBorderBrush}"
                BorderThickness="1"
                Background="{ThemeResource AppScrimStrongBrush}"
                Opacity="0" Visibility="Collapsed"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                Margin="10"
                Padding="16">

            <StackPanel Spacing="14">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="HeaderText" Text="Send to"
                               Foreground="White"
                               FontFamily="{StaticResource AppDisplayFont}"
                               FontSize="16" FontWeight="Bold" />
                    <TextBlock x:Name="ExpandedSubText"
                               Text="Drop on a device, or anywhere here to send to all."
                               Foreground="{ThemeResource AppScrimTextSecondaryBrush}"
                               FontFamily="{StaticResource AppTextFont}"
                               FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="Targets" Spacing="8" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
