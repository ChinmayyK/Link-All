<Window
    x:Class="LinkAll.WinUI.UI.EdgeDropWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Edge drop">

    <!--
        Screen-edge drop target. At rest it is a thin accent bar against the
        screen edge; while a drag hovers, code-behind widens the window and
        shows ExpandedCard, a dark-glass panel (AppScrim* tokens) with an
        icon well and two lines of copy.
    -->
    <Grid Background="Transparent" AllowDrop="True"
          DragEnter="Grid_DragEnter" DragLeave="Grid_DragLeave" Drop="Grid_Drop">

        <Border x:Name="AppTitleBar" Height="1" VerticalAlignment="Top" Background="Transparent" />

        <Border x:Name="RestingSliver"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                CornerRadius="3"
                Margin="0,0,4,0"
                Width="6" Height="96"
                Background="{ThemeResource AppAccentBrush}" />

        <Border x:Name="ExpandedCard"
                CornerRadius="{StaticResource RadiusLarge}"
                BorderBrush="{ThemeResource AppScrimBorderBrush}"
                BorderThickness="1"
                Background="{ThemeResource AppScrimStrongBrush}"
                Opacity="0" Visibility="Collapsed"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                Margin="12"
                Padding="20,24">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <Border Width="48" Height="48"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{ThemeResource AppScrimSubtleBrush}"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE898;" FontSize="20"
                              Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Spacing="6">
                    <TextBlock Text="Drop to send"
                               Foreground="White"
                               FontFamily="{StaticResource AppDisplayFont}"
                               FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="ExpandedSubText"
                               Text="Release to send to your connected devices."
                               Foreground="{ThemeResource AppScrimTextSecondaryBrush}"
                               FontFamily="{StaticResource AppTextFont}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="180" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
