<Window
    x:Class="LinkAll.WinUI.DashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkAll.WinUI"
    xmlns:views="using:LinkAll.WinUI.Views"
    xmlns:services="using:LinkAll.WinUI.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Link All">

    <!--
        Mica on the window, a transparent navigation pane, and a solid
        content pane. That is the Windows 11 shell composition: the backdrop
        belongs to the window, the pane lets it through, and content sits on
        an opaque layer so text never has to fight a blurred desktop.
    -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="212"
                        SelectionChanged="NavView_SelectionChanged"
                        Background="Transparent">

            <!-- Reserves the height our custom title bar overlay draws into,
                 so pane content starts below it. The brand mark itself lives
                 in the overlay, where it is part of the drag region. -->
            <NavigationView.PaneHeader>
                <Border Height="56" />
            </NavigationView.PaneHeader>

            <!--
                Sidebar: one short list of places, then Settings and this PC
                at the bottom. Selection is an accent-tinted fill (Tokens.xaml),
                not the stock indicator bar.
            -->
            <NavigationView.MenuItems>

                <NavigationViewItem Tag="Devices" Content="Devices" x:Name="NavDevices"
                                    Style="{StaticResource AppNavItem}"
                                    AutomationProperties.Name="Devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EA;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Clipboard" Content="Clipboard" x:Name="NavClipboard"
                                    Style="{StaticResource AppNavItem}"
                                    AutomationProperties.Name="Clipboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="DevicePeer" Content="Remote files" x:Name="NavPeer"
                                    Style="{StaticResource AppNavItem}"
                                    AutomationProperties.Name="Remote files">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Transfers" Content="Transfers" x:Name="NavTransfers"
                                    Style="{StaticResource AppNavItem}"
                                    AutomationProperties.Name="Transfers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" FontSize="16" />
                    </NavigationViewItem.Icon>
                    <!-- Running-transfer count, so progress is visible from
                         any page. -->
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind mgr.ActiveTransferCount, Mode=OneWay}"
                                   Visibility="{x:Bind mgr.HasActiveTransfers, Mode=OneWay}"
                                   Background="{ThemeResource AppAccentBrush}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

                <NavigationViewItem Tag="Activity" Content="Activity" x:Name="NavActivity"
                                    Style="{StaticResource AppNavItem}"
                                    AutomationProperties.Name="Activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="Settings" Content="Settings" x:Name="NavSettings"
                                    Style="{StaticResource AppNavItem}"
                                    AutomationProperties.Name="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- This PC and its live status. The whole row opens the
                 app-level commands (rescan, downloads, quit). -->
            <NavigationView.PaneFooter>
                <Border Margin="8,4,8,10">
                    <Button x:Name="LocalDeviceButton"
                            Style="{StaticResource AppNavRowButton}"
                            Margin="0"
                            Padding="10,9"
                            CornerRadius="{StaticResource RadiusMedium}"
                            ToolTipService.ToolTip="This PC - status and app commands"
                            AutomationProperties.Name="This PC. Status and application commands">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Device glyph with a live status dot pinned to
                                 its corner, so "this PC" and "reachable" are
                                 one object rather than two labels. -->
                            <Grid Grid.Column="0" Width="32" Height="32">
                                <Border Background="{ThemeResource AppAccentSubtleBrush}"
                                        CornerRadius="{StaticResource RadiusSmall}" />
                                <FontIcon Glyph="&#xE7F4;" FontSize="15"
                                          Foreground="{ThemeResource AppAccentBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Width="10" Height="10" CornerRadius="5"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-2,-2"
                                        BorderThickness="2"
                                        BorderBrush="{ThemeResource AppBackgroundBrush}"
                                        Background="{x:Bind local:StringToBrushConverter.ToSolidColorBrush(mgr.HeaderStatusBrush), Mode=OneWay}" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind localMachineName, Mode=OneTime}"
                                           Style="{StaticResource AppBodyStrong}"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind mgr.HeaderStatusText, Mode=OneWay}"
                                           Style="{StaticResource AppCaption}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <FontIcon Grid.Column="2" Glyph="&#xE712;" FontSize="13"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem Text="Rescan network" Click="OnRescanClicked">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Open downloads folder" Click="OnOpenDownloadsClicked">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xED25;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Settings" Click="OnOpenSettingsClicked">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Quit Link All" Click="Quit_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7E8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Border>
            </NavigationView.PaneFooter>

            <!-- Content layer: opaque, seamed off from the Mica pane with a
                 single hairline. No border on three sides, no shadow. -->
            <Border Background="{ThemeResource AppBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderSubtleBrush}"
                    BorderThickness="1,0,0,0">
                <Grid AllowDrop="True"
                      DragOver="OnContentDragOver"
                      DragLeave="OnContentDragLeave"
                      Drop="OnContentDrop">
                    <Grid Margin="0,48,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- What stops sync right now (engine health), with its fix. -->
                        <InfoBar Grid.Row="0" Margin="24,0,24,12"
                                 Severity="Warning" IsClosable="False"
                                 IsOpen="{x:Bind mgr.HasHealthIssue, Mode=OneWay}"
                                 Title="{x:Bind mgr.HealthTitle, Mode=OneWay}"
                                 Message="{x:Bind mgr.HealthDetail, Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button Content="{x:Bind mgr.HealthActionLabel, Mode=OneWay}"
                                        Visibility="{x:Bind mgr.HealthActionVisibility, Mode=OneWay}"
                                        Click="OnHealthActionClick" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <Frame x:Name="ContentFrame" Grid.Row="1" Background="Transparent">
                            <Frame.ContentTransitions>
                                <TransitionCollection>
                                    <NavigationThemeTransition />
                                </TransitionCollection>
                            </Frame.ContentTransitions>
                        </Frame>
                    </Grid>

                    <!--
                        Drop affordance for the whole content area. Dragging
                        files onto the app previously did nothing unless you
                        happened to hit the screen-edge sliver, which is a
                        hard target to find on purpose. This makes the window
                        itself the target and says so while you're dragging.
                    -->
                    <Border x:Name="DropOverlay"
                            Margin="0,48,0,0"
                            Background="{ThemeResource AppAccentSubtleBrush}"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <Border Margin="16"
                                CornerRadius="{StaticResource RadiusLarge}"
                                BorderBrush="{ThemeResource AppAccentBrush}"
                                BorderThickness="2">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                                <Border Width="52" Height="52"
                                        CornerRadius="{StaticResource RadiusLarge}"
                                        Background="{ThemeResource AppAccentBrush}"
                                        HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE898;" FontSize="22"
                                              Foreground="{ThemeResource AppOnAccentBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Drop to send"
                                               Style="{StaticResource AppSectionTitle}"
                                               FontSize="16"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="DropOverlayDetail"
                                               Style="{StaticResource AppSecondary}"
                                               HorizontalAlignment="Center"
                                               Text="Release to send these files to a connected device" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </NavigationView>

        <!--
            Custom title bar. Left of the seam it is pure drag surface over
            Mica carrying the brand; right of the seam it is the app's
            command bar: page title on the left, global actions on the right.

            Exactly one filled button lives here - Send file. Everything
            else is a ghost control, so the hierarchy is unambiguous the
            moment you look at it.
        -->
        <Grid x:Name="AppTitleBar" Height="48" VerticalAlignment="Top">
            <!-- Ctrl+N lives here rather than on the "Pair a new device"
                 menu item: an accelerator declared on a MenuFlyoutItem is
                 only in scope while that flyout is open, so it would have
                 been advertised in a tooltip and never fired. Ctrl+O moved
                 here too when its visible "Send file" button was removed
                 (see TitleBarActionsPanel) - the shortcut still works from
                 every page, it just no longer has a redundant second button
                 advertising it on the Devices page. -->
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnPairAcceleratorInvoked" />
                <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnSendAcceleratorInvoked" />
                <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnSearchAcceleratorInvoked" />
            </Grid.KeyboardAccelerators>

            <!--
                Three columns, not two: the title and the action cluster
                used to share a single Width="*" column and rely on opposite
                Margins to keep them apart. That only holds while the window
                is wide enough for both Margins to still leave a gap - at
                the app's actual default/restored size (as opposed to
                maximised) there wasn't enough room, and the title's
                left-anchored text visibly collided with the right-anchored
                status chip. Giving the title its own Width="*" column means
                it truncates (TextTrimming, see AppPageTitle) against a real
                boundary instead of drifting into whatever the actions
                cluster hasn't claimed yet.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Collapsed (not just its content) on the Devices page - a
                 Collapsed child inside it still left this Border's own
                 background band and bottom divider line drawn as an empty
                 strip over the page's content. Collapsing the Border itself
                 lets the identical AppBackgroundBrush from the content
                 layer underneath show through instead, so the space reads
                 as nothing rather than as an empty bar. The 48px of height
                 stays reserved either way (AppTitleBar's own Height, needed
                 for the drag region and to keep content clear of the system
                 caption buttons) - only the visible band goes away. -->
            <Border x:Name="TitleBarBackgroundBorder" Grid.Column="1" Grid.ColumnSpan="2"
                    Background="{ThemeResource AppBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderSubtleBrush}"
                    BorderThickness="1,0,0,1" />

            <!-- Brand -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"
                        VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Width="20" Height="20" Stretch="Uniform"
                       Source="{ThemeResource BrandMarkSource}" />
                <TextBlock Text="Link All" Style="{StaticResource AppSectionTitle}"
                           FontSize="15" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Search, centred in the bar: pages, devices, clipboard items and
                 transfers. Ctrl+F focuses it from anywhere in the window. -->
            <Grid Grid.Column="1" Margin="24,0,12,0" VerticalAlignment="Center">
                <AutoSuggestBox x:Name="SearchBox"
                                MaxWidth="400"
                                PlaceholderText="Search devices, clipboard, transfers"
                                QueryIcon="Find"
                                TextMemberPath="Title"
                                UpdateTextOnSelect="False"
                                AutomationProperties.Name="Search"
                                ToolTipService.ToolTip="Search (Ctrl+F)"
                                GotFocus="SearchBox_GotFocus"
                                TextChanged="SearchBox_TextChanged"
                                QuerySubmitted="SearchBox_QuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="services:SearchHit">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8"
                                        Background="{ThemeResource AppSurfaceSubtleBrush}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11.5"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </Grid>

            <!-- Contextual page title. Collapsed on the Devices page - its
                 own in-content header (title, subtitle, actions) now covers
                 everything this row used to, and showing both was the
                 "Ecosystem" text visibly competing with "Devices" beneath
                 it. Toggled in DashboardWindow.xaml.cs's SetPageTitle. -->
            <TextBlock x:Name="PageTitleText" Grid.Column="1"
                       Text="Devices"
                       Style="{StaticResource AppPageTitle}"
                       VerticalAlignment="Center"
                       Margin="28,0,12,0"
                       HorizontalAlignment="Left" />

            <!-- Global actions. Own column now (see comment above); the
                 148px right margin still clears the system caption buttons,
                 which are drawn on top of this content, not reserved space
                 the Grid knows about. Keep it in sync if the window ever
                 gains a maximise-restore variant.

                 Collapsed on the Devices page for the same reason as
                 PageTitleText: its own header already has Send files/Scan
                 nearby/Pair device/Settings, so this row was showing a
                 second "Send file" button doing the same thing. Still used
                 (and visible) on every other page, which has no header of
                 its own yet. -->
            <StackPanel x:Name="TitleBarActionsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,148,0">

                <!-- Live connection state. A button, not a label: it opens
                     the network detail people would otherwise hunt for in
                     Settings. -->
                <Button x:Name="StatusChipButton"
                        Style="{StaticResource AppGhostButton}"
                        Padding="8,4"
                        FontWeight="Normal"
                        ToolTipService.ToolTip="Connection status"
                        AutomationProperties.Name="Connection status">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4"
                                Background="{x:Bind local:StringToBrushConverter.ToSolidColorBrush(mgr.HeaderStatusBrush), Mode=OneWay}"
                                services:PulseEffects.EnablePulse="{x:Bind mgr.IsSearching, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind mgr.HeaderStatusText, Mode=OneWay}"
                                   Style="{StaticResource AppSecondary}"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="252" Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Local network" Style="{StaticResource AppBodyStrong}" />
                                    <TextBlock Text="{x:Bind mgr.EcosystemSummaryText, Mode=OneWay}"
                                               Style="{StaticResource AppSecondary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Style="{StaticResource AppDivider}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Paired devices"
                                               Style="{StaticResource AppSecondary}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind mgr.KnownDeviceCount, Mode=OneWay}"
                                               Style="{StaticResource AppMetric}" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Seen nearby"
                                               Style="{StaticResource AppSecondary}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind mgr.NearbyDeviceCount, Mode=OneWay}"
                                               Style="{StaticResource AppMetric}" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Local service"
                                               Style="{StaticResource AppSecondary}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind mgr.DaemonStatusText, Mode=OneWay}"
                                               Style="{StaticResource AppMetric}" />
                                </Grid>

                                <Button Style="{StaticResource AppSecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Content="Rescan network"
                                        Click="OnRescanClicked" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Border Width="1" Height="18" Margin="2,0"
                        Background="{ThemeResource AppBorderSubtleBrush}" />

                <Button Style="{StaticResource AppIconButton}"
                        ToolTipService.ToolTip="Scan for nearby devices (Ctrl+R)"
                        AutomationProperties.Name="Scan for nearby devices"
                        Click="OnTitleBarScanClicked">
                    <FontIcon Glyph="&#xE72C;" FontSize="15" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="R" />
                    </Button.KeyboardAccelerators>
                </Button>

                <Button Style="{StaticResource AppIconButton}"
                        ToolTipService.ToolTip="More actions"
                        AutomationProperties.Name="More actions">
                    <FontIcon Glyph="&#xE712;" FontSize="15" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Pair a new device" Click="OnPairDeviceClicked"
                                            KeyboardAcceleratorTextOverride="Ctrl+N">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xED14;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Open downloads folder" Click="OnOpenDownloadsClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xED25;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Settings" Click="OnOpenSettingsClicked">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE713;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
