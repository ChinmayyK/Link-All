<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LinkAll.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LinkAll</AssemblyName>
    <!-- The exe keeps its file name; these are what Task Manager, Settings and file properties show. -->
    <Product>Link All</Product>
    <AssemblyTitle>Link All</AssemblyTitle>
    <Company>Link All</Company>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <!-- The UI is English-only; skip .NET satellite resource assemblies for other cultures. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\LockScreenLogo.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Square150x150Logo.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Square44x44Logo.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\StoreLogo.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\AppIcon.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\AppIconDark.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\BrandMarkDark.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\TrayIconDark.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\TrayIcon.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\Wide310x150Logo.scale-200.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Native Rust DLL. Intentionally has only two sources, both built from
      current source:
        1. A DLL dropped directly next to this project (manual dev override).
        2. The `cargo build` release output for linkall-core.
      Do NOT add a fallback onto release/windows/linkall_core.dll - that
      directory holds a historical release snapshot, not a build input, and
      silently linking against it ships a stale/mismatched core (see commits
      3aa1fb2 / 18fdadb, which patched the C# IPC protocol to match that
      stale DLL instead of rebuilding it).
    -->
    <None Include="linkall_core.dll" Condition="Exists('linkall_core.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>linkall_core.dll</Link>
    </None>
    <None Include="..\..\..\target\release\linkall_core.dll" Condition="!Exists('linkall_core.dll') and Exists('..\..\..\target\release\linkall_core.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>linkall_core.dll</Link>
    </None>
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup>
     above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.4.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!--
    System tray helper: platforms/windows/tray (Rust, native Win32, ~0.3 MB).
    It runs as its own process so the icon survives UI crashes and the app can
    drop its window while in the tray. It replaced the WinForms LinkAll.Tray,
    whose second self-contained .NET runtime cost ~110 MB.

    TrayService.cs launches and watches <baseDir>\tray\LinkAll.Tray.exe, so the
    Rust binary is copied under that name. BuildTrayApp runs cargo from the
    repository root (Rust is already needed for linkall_core.dll); pass
    -p:SkipTrayBuild=true to reuse an existing target\release\linkall-tray.exe.

    The publish copy is its own target that runs only after Publish:
    PublishDir defaults to $(OutDir)publish\ on every build, so a copy guarded
    by a non-empty PublishDir used to write a stale tray\ into publish\ on
    each plain `dotnet build`.
  -->
  <PropertyGroup>
    <LinkAllRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\'))</LinkAllRepoRoot>
    <TrayExe>$(LinkAllRepoRoot)target\release\linkall-tray.exe</TrayExe>
  </PropertyGroup>

  <Target Name="BuildTrayApp" BeforeTargets="Build" Condition="'$(SkipTrayBuild)' != 'true'">
    <Exec Command="cargo build --release -p linkall-tray" WorkingDirectory="$(LinkAllRepoRoot)" />
  </Target>

  <Target Name="CopyTrayApp" AfterTargets="Build">
    <Error Condition="!Exists('$(TrayExe)')" Text="Tray helper not found at $(TrayExe). Run: cargo build --release -p linkall-tray" />
    <!-- Clears any leftover WinForms tray files (runtime, DLLs) from older builds. -->
    <RemoveDir Directories="$(OutDir)tray" ContinueOnError="true" />
    <Copy SourceFiles="$(TrayExe)" DestinationFiles="$(OutDir)tray\LinkAll.Tray.exe" />
  </Target>

  <Target Name="PublishTrayApp" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)tray" ContinueOnError="true" />
    <Copy SourceFiles="$(TrayExe)" DestinationFiles="$(PublishDir)tray\LinkAll.Tray.exe" />
  </Target>

  <!--
    WinUI ships Microsoft.ui.xaml.dll.mui string tables for about 90 locales,
    one folder each. SatelliteResourceLanguages doesn't cover them: they are
    Windows MUI files, not .NET satellite assemblies. The app's own UI is
    English-only, so the published app keeps en-us and drops the rest. On
    other display languages Windows' MUI loader falls back to the DLL's
    built-in en-US strings, so built-in control text (context menus,
    accessibility names) reads in English there.
  -->
  <Target Name="PruneWinUiLocales" AfterTargets="Publish">
    <ItemGroup>
      <ForeignMuiFiles Include="$(PublishDir)*\*.mui" Exclude="$(PublishDir)en-us\*.mui" />
      <ForeignMuiDirs Include="@(ForeignMuiFiles->'%(RootDir)%(Directory)'->Distinct())" />
    </ItemGroup>
    <RemoveDir Directories="@(ForeignMuiDirs)" ContinueOnError="true" />
  </Target>

  <!--
    Self-contained Windows App SDK deployment leaves out
    Microsoft.WindowsAppRuntime.Insights.Resource.dll, although the runtime
    MSIX ships it. AppNotificationManager.Register() needs it and failed with
    0x8007007E ("module could not be found") on every launch without it, so
    toast buttons never activated the app. Copy it out of the runtime MSIX in
    the Microsoft.WindowsAppSDK.Runtime package (MicrosoftWindowsAppSDKPackageDir
    is that package's root), so it follows the SDK version.
  -->
  <Target Name="_FindWindowsAppRuntimeMsix">
    <PropertyGroup>
      <_RuntimeMsixPath>$(MicrosoftWindowsAppSDKPackageDir)tools\MSIX\win10-$(RuntimeIdentifier.Replace('win-', ''))\Microsoft.WindowsAppRuntime.2.msix</_RuntimeMsixPath>
    </PropertyGroup>
    <ItemGroup>
      <_RuntimeMsix Include="$(_RuntimeMsixPath)" Condition="Exists('$(_RuntimeMsixPath)')" />
    </ItemGroup>
    <Error Condition="'@(_RuntimeMsix)' == ''" Text="Windows App Runtime MSIX not found at $(_RuntimeMsixPath); cannot copy Microsoft.WindowsAppRuntime.Insights.Resource.dll." />
  </Target>

  <Target Name="CopyWindowsAppRuntimeInsights" AfterTargets="Build" DependsOnTargets="_FindWindowsAppRuntimeMsix">
    <Unzip SourceFiles="@(_RuntimeMsix)" DestinationFolder="$(OutDir)" Include="Microsoft.WindowsAppRuntime.Insights.Resource.dll" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishWindowsAppRuntimeInsights" AfterTargets="Publish" DependsOnTargets="_FindWindowsAppRuntimeMsix">
    <Unzip SourceFiles="@(_RuntimeMsix)" DestinationFolder="$(PublishDir)" Include="Microsoft.WindowsAppRuntime.Insights.Resource.dll" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Self-contained Microsoft.WindowsAppSDK 2.3.1 deploys its Windows AI /
    Copilot Runtime component (Phi Silica, ContentSafety, Imaging super
    resolution, OnnxRuntime + DirectML) unconditionally - there is no project
    setting to opt out of it, only a FrameworkReference-driven runtime pack
    that ships as one indivisible blob. Link All calls none of it (grep for
    Windows.AI./OnnxRuntime/DirectML/MachineLearning across the whole project
    turns up nothing), so it is ~42 MB of dead weight in every install.
    Deleting the files post-build/publish is safe: nothing in this codebase
    ever loads them, so there is no lazy-load path left to break.
  -->
  <Target Name="TrimUnusedWindowsAiRuntime" AfterTargets="Build;Publish">
    <ItemGroup>
      <UnusedAiFiles Include="$(OutDir)Microsoft.Windows.AI.*" />
      <UnusedAiFiles Include="$(OutDir)onnxruntime.dll" />
      <UnusedAiFiles Include="$(OutDir)DirectML.dll" />
      <UnusedAiFiles Include="$(OutDir)Microsoft.ML.OnnxRuntime.dll" />
      <UnusedAiFiles Include="$(PublishDir)Microsoft.Windows.AI.*" Condition="'$(PublishDir)' != ''" />
      <UnusedAiFiles Include="$(PublishDir)onnxruntime.dll" Condition="'$(PublishDir)' != ''" />
      <UnusedAiFiles Include="$(PublishDir)DirectML.dll" Condition="'$(PublishDir)' != ''" />
      <UnusedAiFiles Include="$(PublishDir)Microsoft.ML.OnnxRuntime.dll" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(UnusedAiFiles)" TreatErrorsAsWarnings="true" />
  </Target>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>


  <!--
    Publish as Native AOT: the app compiles to one native LinkAll.exe with no .NET runtime
    or JIT shipped alongside it, which is most of the size saved (see docs/windows-size-plan.md).
    AOT also turns on the trim and AOT analyzers for every build. Keep them at zero warnings:
    an IL2xxx/IL3xxx warning here is a crash at runtime in the published app. Do not add
    NoWarn or SuppressTrimAnalysis to silence one; fix the code instead.
  -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <!-- The native LinkAll.pdb is ~52 MB. Keep it in bin\ for crash debugging,
         out of the publish folder that the MSI and zip ship. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

</Project>
