<Page
    x:Class="LinkAll.WinUI.Views.ClipboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkAll.WinUI.Views"
    xmlns:winui="using:LinkAll.WinUI"
    xmlns:services="using:LinkAll.WinUI.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Clipboard, in the shared Android/Windows layout: a large heading,
        what is waiting to be applied, then the history as one grouped list
        with hairline rows. Content leads each row - the text you copied is
        how you recognise it; type, device and age are metadata.
    -->
    <Page.Resources>
        <DataTemplate x:Key="ClipboardRowTemplate" x:DataType="winui:ActivityEntry">
            <Grid Padding="16,12" ColumnSpacing="14" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="3" Height="1" Margin="50,-12,-16,0"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AppDividerBrush}" />

                <Border Grid.Column="0" Width="36" Height="36" VerticalAlignment="Top"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{ThemeResource AppSurfaceSubtleBrush}">
                    <FontIcon Glyph="{x:Bind kind, Converter={StaticResource ActivityKindToGlyphConverter}, Mode=OneWay}"
                              FontSize="15"
                              Foreground="{x:Bind AccentColor, Converter={StaticResource StringToBrushConverter}, Mode=OneWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind Preview, Mode=OneWay}"
                               Style="{StaticResource AppBody}"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind TypeLabel, Mode=OneWay}" Style="{StaticResource AppCaption}" FontWeight="SemiBold" />
                        <TextBlock Text="&#183;" Style="{StaticResource AppCaption}" />
                        <TextBlock Text="{x:Bind Source, Mode=OneWay}" Style="{StaticResource AppCaption}" />
                        <TextBlock Text="&#183;" Style="{StaticResource AppCaption}" />
                        <TextBlock Text="{x:Bind RelativeTime, Mode=OneWay}" Style="{StaticResource AppCaption}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Style="{StaticResource AppPrimaryButton}"
                            Content="Apply"
                            Visibility="{x:Bind CanApply, Converter={StaticResource BoolToVisibleConverter}, Mode=OneWay}"
                            ToolTipService.ToolTip="Put this on the Windows clipboard"
                            Click="OnApplyActivityClicked" />
                    <Button Style="{StaticResource AppIconButton}"
                            ToolTipService.ToolTip="Copy to the Windows clipboard"
                            AutomationProperties.Name="Copy to the Windows clipboard"
                            Click="OnCopyActivityTextClicked">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource AppIconButton}"
                            ToolTipService.ToolTip="Send to a connected device"
                            AutomationProperties.Name="Send to a connected device"
                            Click="OnSendActivityClicked">
                        <FontIcon Glyph="&#xE898;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="24" MaxWidth="1000">

            <!-- Header -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Clipboard" Style="{StaticResource AppDisplayText}" />
                    <TextBlock Style="{StaticResource AppSecondary}"
                               Text="{x:Bind mgr.ClipboardSummaryText, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AppPrimaryButton}" Padding="18,8"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Send what's on this PC's clipboard to a device"
                        Click="OnPushLocalClipboardClicked">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE898;" FontSize="13" />
                        <TextBlock Text="Send clipboard" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Waiting to be applied: the one actionable thing here, so it
                 leads the page. -->
            <StackPanel Spacing="10"
                        Visibility="{x:Bind mgr.HasPendingClipboards, Converter={StaticResource BoolToVisibleConverter}, Mode=OneWay}">
                <TextBlock Text="Waiting for you" Style="{StaticResource AppSectionTitle}" />
                <Border Style="{StaticResource AppGroupCard}" BorderBrush="{ThemeResource AppAccentBrush}">
                    <ItemsControl Margin="0,-1,0,0" ItemsSource="{x:Bind mgr.PendingClipboards, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="winui:PendingClipboard">
                                <Grid Padding="16,12" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="3" Height="1" Margin="54,-12,-16,0"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource AppDividerBrush}" />
                                    <Border Grid.Column="0" Style="{StaticResource AppIconTile}"
                                            Background="{ThemeResource AppAccentSubtleBrush}">
                                        <FontIcon Glyph="&#xE77F;" FontSize="16"
                                                  Foreground="{ThemeResource AppAccentBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Preview, Mode=OneWay}"
                                                   Style="{StaticResource AppBodyStrong}"
                                                   MaxLines="2" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind from_device, Mode=OneWay}" Style="{StaticResource AppCaption}" />
                                            <TextBlock Text="&#183;" Style="{StaticResource AppCaption}" />
                                            <TextBlock Text="{x:Bind RelativeTime, Mode=OneWay}" Style="{StaticResource AppCaption}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource AppPrimaryButton}"
                                            Content="Apply"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Put this on the Windows clipboard"
                                            Click="OnApplyPendingClicked" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- History -->
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Filter chips: the selected one is filled, the rest
                         outlined (styles are swapped in ApplyChipSelection). -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="ChipAll" Content="All"
                                Style="{StaticResource AppPrimaryButton}"
                                Padding="14,5" MinHeight="30"
                                Click="OnFilterChipClicked" />
                        <Button x:Name="ChipText" Content="Text"
                                Style="{StaticResource AppSecondaryButton}"
                                Padding="14,5" MinHeight="30"
                                Click="OnFilterChipClicked" />
                        <Button x:Name="ChipImage" Content="Image"
                                Style="{StaticResource AppSecondaryButton}"
                                Padding="14,5" MinHeight="30"
                                Click="OnFilterChipClicked" />
                        <Button x:Name="ChipFile" Content="File"
                                Style="{StaticResource AppSecondaryButton}"
                                Padding="14,5" MinHeight="30"
                                Click="OnFilterChipClicked" />
                    </StackPanel>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             MaxWidth="320"
                             HorizontalAlignment="Right"
                             PlaceholderText="Search history"
                             MinHeight="32"
                             TextChanged="OnSearchTextChanged"
                             AutomationProperties.Name="Search clipboard history" />
                </Grid>

                <!-- Visibility is driven from UpdateFilter() in code-behind:
                     FilteredFeed is rebuilt on every keystroke, and x:Bind to
                     a collection's Count never hears CollectionChanged. -->
                <Border x:Name="EmptyStatePanel"
                        Style="{StaticResource AppCard}"
                        Background="Transparent"
                        Padding="20,18"
                        Visibility="Collapsed">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8C8;" FontSize="20"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="EmptyStateTitle" Text="Nothing here yet" Style="{StaticResource AppBodyStrong}" />
                            <TextBlock x:Name="EmptyStateDetail" Style="{StaticResource AppSecondary}" TextWrapping="Wrap"
                                       Text="Copy something on this PC or a paired device and it shows up here, ready to paste on either end." />
                        </StackPanel>
                        <Button x:Name="EmptyStateAction" Grid.Column="2"
                                Style="{StaticResource AppSecondaryButton}"
                                Content="Send this PC's clipboard"
                                VerticalAlignment="Center"
                                Click="OnPushLocalClipboardClicked" />
                    </Grid>
                </Border>

                <Border x:Name="HistoryPanel"
                        Style="{StaticResource AppGroupCard}"
                        Visibility="Collapsed">
                    <ListView Margin="0,-1,0,0"
                              SelectionMode="None"
                              Padding="0"
                              IsItemClickEnabled="False"
                              ItemContainerStyle="{StaticResource AppPlainListItem}"
                              ItemTemplate="{StaticResource ClipboardRowTemplate}"
                              ItemsSource="{x:Bind FilteredFeed, Mode=OneWay}" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
