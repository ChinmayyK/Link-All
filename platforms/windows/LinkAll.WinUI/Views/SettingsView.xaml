<Page
    x:Class="LinkAll.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:LinkAll.WinUI.UI"
    xmlns:local="using:LinkAll.WinUI.Views"
    xmlns:winui="using:LinkAll.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Windows settings pattern: a single scrolling column of labelled
        groups, each group one card of hairline-separated rows. Every row is
        icon / title / description / control, in that order, at a consistent
        52px minimum height.

        The previous page mixed 12px and 16px paddings, three heading sizes
        and a coloured icon per section, which made a short settings list feel
        like six unrelated panels.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ui:PageColumn MaxContentWidth="860">
        <StackPanel Padding="{StaticResource PagePadding}"
                    Spacing="28">

            <!-- Header, then this PC's identity card, as on Android. -->
            <StackPanel Spacing="20">
                <TextBlock Text="Settings" Style="{StaticResource AppDisplayText}" />
                <Border Style="{StaticResource AppGroupCard}">
                    <Grid Padding="16,14" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppAccentSubtleBrush}">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource AppAccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind DeviceName, Mode=OneTime}" Style="{StaticResource AppBodyStrong}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="7" Height="7" CornerRadius="3.5" VerticalAlignment="Center"
                                        Background="{x:Bind winui:StringToBrushConverter.ToSolidColorBrush(mgr.HeaderStatusBrush), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind mgr.DaemonStatusText, Mode=OneWay}" Style="{StaticResource AppSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Categories: each jumps to its group below. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource AppSecondaryButton}" Content="Keyboard &amp; mouse" Tag="CatShare" Click="OnCategoryClicked" />
                    <Button Style="{StaticResource AppSecondaryButton}" Content="Sync &amp; clipboard" Tag="CatSync" Click="OnCategoryClicked" />
                    <Button Style="{StaticResource AppSecondaryButton}" Content="Continuity" Tag="CatContinuity" Click="OnCategoryClicked" />
                    <Button Style="{StaticResource AppSecondaryButton}" Content="Files" Tag="CatFiles" Click="OnCategoryClicked" />
                    <Button Style="{StaticResource AppSecondaryButton}" Content="Devices" Tag="CatDevices" Click="OnCategoryClicked" />
                    <Button Style="{StaticResource AppSecondaryButton}" Content="Appearance" Tag="CatAppearance" Click="OnCategoryClicked" />
                    <Button Style="{StaticResource AppSecondaryButton}" Content="Startup" Tag="CatStartup" Click="OnCategoryClicked" />
                    <Button Style="{StaticResource AppSecondaryButton}" Content="Security" Tag="CatSecurity" Click="OnCategoryClicked" />
                    <Button Style="{StaticResource AppSecondaryButton}" Content="Advanced" Tag="CatAdvanced" Click="OnCategoryClicked" />
                    <Button Style="{StaticResource AppSecondaryButton}" Content="About" Tag="CatAbout" Click="OnCategoryClicked" />
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ KEYBOARD &AMP; MOUSE -->
            <StackPanel x:Name="CatShare" Spacing="8">
                <TextBlock Text="Keyboard &amp; mouse" Style="{StaticResource AppSectionTitle}" />

                <!-- One keyboard and mouse across computers. Off until turned on. -->
                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE765;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Share this keyboard and mouse" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Push the pointer past a screen edge to control the computer next to this one"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="EdgeControlToggle" Grid.Column="2" MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnEdgeControlToggled"
                                          AutomationProperties.Name="Share this keyboard and mouse" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="52" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="48,0,0,0"
                                       Text="Choose which computer sits on each side, and check each is ready"
                                       Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="Open" Style="{StaticResource AppSecondaryButton}"
                                    Click="OnOpenKeyboardMouse" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ SYNC &AMP; CLIPBOARD -->
            <StackPanel x:Name="CatSync" Spacing="8">
                <TextBlock Text="Sync &amp; clipboard" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8C8;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Share clipboard automatically" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Copy on one device, paste on another, without confirming each time"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind mgr.SyncEnabled, Mode=TwoWay}" MinWidth="0"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Share clipboard automatically" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Filter sensitive clipboard content" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Block OTP codes, API keys, and passwords from automatic sync"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind mgr.OtpShieldEnabled, Mode=TwoWay}" MinWidth="0"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Filter sensitive clipboard content" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB9F;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Send new screenshots automatically" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Push screenshots to your connected devices as you take them"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ScreenshotSyncToggle" Grid.Column="2" MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnScreenshotSyncToggled"
                                          AutomationProperties.Name="Send new screenshots automatically" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8A7;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Drop zone at the screen edge" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Drag a file to the right edge of your screen to pick a device to send it to"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="EdgeDropToggle" Grid.Column="2" MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnEdgeDropToggled"
                                          AutomationProperties.Name="Drop zone at the screen edge" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ CONTINUITY -->
            <StackPanel x:Name="CatContinuity" Spacing="8">
                <TextBlock Text="Continuity" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE964;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Let phones control this PC" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Paired phones can press play/pause, volume and the arrow keys for slides, move the pointer and type, lock this PC, turn its screen off and make it ring"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="RemoteControlToggle" Grid.Column="2" MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnRemoteControlToggled"
                                          AutomationProperties.Name="Let phones control this PC" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEA8F;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Show phone notifications" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Pop up notifications from your Android phone on this PC"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="PhoneNotificationsToggle" Grid.Column="2" MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnPhoneNotificationsToggled"
                                          AutomationProperties.Name="Show phone notifications" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Lock when my phone leaves" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Locks this PC when the paired phone that was connected has been gone for 30 seconds. A phone that sleeps or loses Wi-Fi counts as gone"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="WalkAwayToggle" Grid.Column="2" MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnWalkAwayToggled"
                                          AutomationProperties.Name="Lock when my phone leaves" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Link All Drop" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Files you put in the Link All Drop folder in your user folder are sent to your paired devices on their own"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DropFolderToggle" Grid.Column="2" MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnDropFolderToggled"
                                          AutomationProperties.Name="Link All Drop" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <!-- Off until the owner turns it on; while off, a phone
                             that tries to browse is told so. -->
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Let devices browse files" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Paired phones can list, preview and fetch files from this PC's Documents, Downloads, Pictures, Videos and Music folders"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="FileBrowsingToggle" Grid.Column="2" MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnFileBrowsingToggled"
                                          AutomationProperties.Name="Let devices browse files" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ FILES -->
            <StackPanel x:Name="CatFiles" Spacing="8">
                <TextBlock Text="Files" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xED25;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Where received files are saved" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Incoming files always land in your Windows Downloads folder"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource AppSecondaryButton}"
                                    Content="Open folder"
                                    VerticalAlignment="Center"
                                    Click="OnOpenDownloadsClicked" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ DEVICES -->
            <StackPanel x:Name="CatDevices" Spacing="8">
                <TextBlock Text="Devices" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="This PC's name" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="How this computer appears to your other devices"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind DeviceName, Mode=OneTime}"
                                       Style="{StaticResource AppMetric}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8EA;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Paired devices" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="{x:Bind mgr.EcosystemSummaryText, Mode=OneWay}"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource AppSecondaryButton}"
                                    Content="Manage"
                                    VerticalAlignment="Center"
                                    Click="OnManageDevicesClicked" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Network discovery" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Broadcast on the local network to find nearby devices"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource AppSecondaryButton}"
                                    Content="Rescan now"
                                    VerticalAlignment="Center"
                                    Click="OnRescanClicked" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE897;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Welcome guide" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="See how to connect your first device again"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource AppSecondaryButton}"
                                    Content="Show"
                                    VerticalAlignment="Center"
                                    Click="OnReplayOnboardingClicked" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ APPEARANCE -->
            <StackPanel x:Name="CatAppearance" Spacing="8">
                <TextBlock Text="Appearance" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE790;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Appearance" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Match Windows, or lock Link All to light or dark"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeSelector" Grid.Column="2" MinWidth="130"
                                      VerticalAlignment="Center"
                                      SelectionChanged="OnThemeSelectionChanged"
                                      AutomationProperties.Name="Appearance">
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                                <ComboBoxItem Content="Use system setting" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ STARTUP -->
            <StackPanel x:Name="CatStartup" Spacing="8">
                <TextBlock Text="Startup" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7E8;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Start with Windows" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Run quietly in the system tray after you sign in"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnStartupToggled"
                                          AutomationProperties.Name="Start with Windows" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid x:Name="UpdateRow" Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Check for updates" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Asks GitHub once a day if a newer version exists. Never installs anything."
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="UpdateCheckToggle" Grid.Column="2" MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnUpdateCheckToggled"
                                          AutomationProperties.Name="Check for updates" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ SECURITY -->
            <StackPanel x:Name="CatSecurity" Spacing="8">
                <TextBlock Text="Security" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <!-- Encryption isn't a setting - it's a fact about how
                             this works. Stating it plainly buys more trust
                             than a toggle that can't be turned off. -->
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSuccessSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource AppSuccessBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="End-to-end encryption" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Every transfer stays on your local network and is encrypted between paired devices"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource AppChip}"
                                    Background="{ThemeResource AppSuccessSubtleBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Always on" Style="{StaticResource AppCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppSuccessBrush}" />
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppDangerSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource AppDangerBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Forget all devices" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Clear every pairing key on this PC. Each device will have to pair again."
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource AppDestructiveButton}"
                                    Content="Forget all"
                                    VerticalAlignment="Center"
                                    Click="OnRevokeAllClicked" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ ADVANCED -->
            <StackPanel x:Name="CatAdvanced" Spacing="8">
                <TextBlock Text="Advanced" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Local service" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="The background engine that talks to your other devices"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Style="{StaticResource AppChip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="7" Height="7" CornerRadius="4"
                                                VerticalAlignment="Center"
                                                Background="{x:Bind winui:StringToBrushConverter.ToSolidColorBrush(mgr.HeaderStatusBrush), Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind mgr.DaemonStatusText, Mode=OneWay}"
                                                   Style="{StaticResource AppCaption}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource AppSecondaryButton}"
                                        Content="View logs"
                                        Click="OnViewLogsClicked" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEBE8;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Report a problem" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock x:Name="ReportStatusText"
                                           Text="Versions, device states and recent log lines. No clipboard text, file names, device names or full addresses."
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Style="{StaticResource AppSecondaryButton}" Content="Copy"
                                        Click="OnCopyReportClicked" />
                                <Button Style="{StaticResource AppSecondaryButton}" Content="Save"
                                        Click="OnSaveReportClicked" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ ABOUT -->
            <StackPanel x:Name="CatAbout" Spacing="8">
                <TextBlock Text="About" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Link All for Windows" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock x:Name="VersionText" Text="No cloud, no account, no telemetry"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
        </ui:PageColumn>
    </ScrollViewer>
</Page>
