<Page
    x:Class="LinkAll.WinUI.Views.ActivityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:LinkAll.WinUI.UI"
    xmlns:local="using:LinkAll.WinUI.Views"
    xmlns:root="using:LinkAll.WinUI"
    xmlns:services="using:LinkAll.WinUI.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The log, in the shared Android/Windows layout: large heading with a
        live count, a filter box, then one grouped list with hairline rows.
        Each row is the daemon's own sentence for the event, so the log
        reads the same on every platform.
    -->
    <ui:PageColumn MaxContentWidth="1000">
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Activity" Style="{StaticResource AppDisplayText}" />
            <TextBlock x:Name="CountText" Style="{StaticResource AppSecondary}" />
        </StackPanel>

        <TextBox x:Name="TxtSearch"
                 Grid.Row="1"
                 MaxWidth="380"
                 HorizontalAlignment="Left"
                 PlaceholderText="Filter events"
                 MinHeight="32"
                 TextChanged="TxtSearch_TextChanged"
                 AutomationProperties.Name="Filter activity" />

        <Border Grid.Row="2"
                x:Name="EmptyStateBorder"
                Style="{StaticResource AppCard}"
                Background="Transparent"
                Padding="20,18"
                Visibility="Collapsed">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE81C;" FontSize="20"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" Text="No activity yet" Style="{StaticResource AppBodyStrong}" />
                    <TextBlock x:Name="EmptyDetail" Style="{StaticResource AppSecondary}" TextWrapping="Wrap"
                               Text="Clipboard syncs, file transfers, and connection events will be recorded here." />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                x:Name="TimelinePanel"
                Style="{StaticResource AppGroupCard}"
                VerticalAlignment="Top">
            <ListView x:Name="TimelineList"
                      Margin="0,-1,0,0"
                      SelectionMode="None"
                      Padding="0"
                      IsItemClickEnabled="False"
                      ItemContainerStyle="{StaticResource AppPlainListItem}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="root:ActivityEntry">
                        <Grid Padding="16,11" ColumnSpacing="12" Background="Transparent"
                              Tapped="ActivityRow_Tapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.ColumnSpan="3" Height="1" Margin="50,-11,-16,0"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource AppDividerBrush}" />

                            <Border Grid.Column="0" Width="36" Height="36"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Background="{ThemeResource AppSurfaceSubtleBrush}">
                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                                          FontSize="14"
                                          Foreground="{x:Bind AccentColor, Converter={StaticResource StringToBrushConverter}, Mode=OneWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Grid.Column="1" Text="{x:Bind summary, Mode=OneWay}"
                                       Style="{StaticResource AppBody}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="2" Text="{x:Bind RelativeTime, Mode=OneWay}"
                                       Style="{StaticResource AppCaption}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       MinWidth="64" TextAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
    </ui:PageColumn>
</Page>
