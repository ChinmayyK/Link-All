<Page
    x:Class="LinkAll.WinUI.Views.ActivityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LinkAll.WinUI.Views"
    xmlns:root="using:LinkAll.WinUI"
    xmlns:services="using:LinkAll.WinUI.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The log, in the shared Android/Windows layout: large heading with a
        live count, a filter box, then one grouped list with hairline rows.
        Row actions reveal on hover so the log reads as text.
    -->
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="18" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Activity" Style="{StaticResource AppDisplayText}" />
            <TextBlock x:Name="CountText" Style="{StaticResource AppSecondary}" />
        </StackPanel>

        <TextBox x:Name="TxtSearch"
                 Grid.Row="1"
                 MaxWidth="380"
                 HorizontalAlignment="Left"
                 PlaceholderText="Filter events, paths and text"
                 MinHeight="32"
                 TextChanged="TxtSearch_TextChanged"
                 AutomationProperties.Name="Filter activity" />

        <Border Grid.Row="2"
                x:Name="EmptyStateBorder"
                Style="{StaticResource AppCard}"
                Background="Transparent"
                Padding="20,18"
                Visibility="Collapsed">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE81C;" FontSize="20"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" Text="No activity yet" Style="{StaticResource AppBodyStrong}" />
                    <TextBlock x:Name="EmptyDetail" Style="{StaticResource AppSecondary}" TextWrapping="Wrap"
                               Text="Clipboard syncs, file transfers, and connection events will be recorded here." />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                x:Name="TimelinePanel"
                Style="{StaticResource AppGroupCard}"
                VerticalAlignment="Top">
            <ListView x:Name="TimelineList"
                      Margin="0,-1,0,0"
                      SelectionMode="None"
                      Padding="0"
                      IsItemClickEnabled="False"
                      ItemContainerStyle="{StaticResource AppPlainListItem}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="root:HistoryItem">
                        <Grid Padding="16,11" ColumnSpacing="12" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.ColumnSpan="4" Height="1" Margin="50,-11,-16,0"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource AppDividerBrush}" />

                            <Border Grid.Column="0" Width="36" Height="36"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Background="{ThemeResource AppSurfaceSubtleBrush}">
                                <FontIcon Glyph="{x:Bind Glyph}"
                                          FontSize="14"
                                          Foreground="{x:Bind PinColor, Converter={StaticResource StringToBrushConverter}, Mode=OneWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind display_text}"
                                           Style="{StaticResource AppBodyStrong}"
                                           FontWeight="Normal"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind path}"
                                           Style="{StaticResource AppCaption}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind HasPath, Converter={StaticResource BoolToVisibleConverter}}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{x:Bind RelativeTime}"
                                       Style="{StaticResource AppMono}" FontSize="11.5"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       MinWidth="64" TextAlignment="Right" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                        VerticalAlignment="Center"
                                        services:RevealEffects.RevealOnHover="True">
                                <Button Style="{StaticResource AppIconButtonSmall}"
                                        Click="BtnPinItem_Click"
                                        ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                                        AutomationProperties.Name="Pin or unpin this event">
                                    <FontIcon Glyph="&#xE718;" FontSize="13"
                                              Foreground="{x:Bind PinColor, Converter={StaticResource StringToBrushConverter}, Mode=OneWay}" />
                                </Button>
                                <Button Style="{StaticResource AppIconButtonSmall}"
                                        Click="BtnDeleteItem_Click"
                                        ToolTipService.ToolTip="Remove from the log"
                                        AutomationProperties.Name="Remove this event from the log">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
