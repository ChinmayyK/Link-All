<Window
    x:Class="Deskdrop.WinUI.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Welcome to Link All">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        First run. A plain page: left-aligned headline, one sentence, the
        primary action, then a "On your network" section with a bordered
        empty state while discovery runs. Mirrors the Android onboarding.
    -->
    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Border x:Name="AppTitleBar" Height="36" VerticalAlignment="Top" Background="Transparent" />

        <!-- CardRoot and CardTranslate drive the entrance animation in code-behind. -->
        <Border x:Name="CardRoot"
                Margin="0,36,0,0"
                Background="Transparent"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" Y="12" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" x:Name="Step1View" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="40,8,40,24" MaxWidth="600"
                                    HorizontalAlignment="Left">

                            <Border Style="{StaticResource AppIconTile}"
                                    Background="{ThemeResource AppAccentSubtleBrush}"
                                    HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE8EA;" FontSize="18"
                                          Foreground="{ThemeResource AppAccentBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="Connect your first device"
                                       Style="{StaticResource AppDisplayText}"
                                       TextWrapping="WrapWholeWords"
                                       Margin="0,20,0,0" />

                            <TextBlock Style="{StaticResource AppSecondary}"
                                       FontSize="13.5"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Text="Open Link All on your phone or another computer, then scan the pairing code. Everything stays on your local network." />

                            <Button Style="{StaticResource AppPrimaryButton}"
                                    Padding="20,9"
                                    Margin="0,24,0,0"
                                    HorizontalAlignment="Left"
                                    Click="BtnShowQRCode_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xED14;" FontSize="14" />
                                    <TextBlock Text="Show pairing code" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="On your network"
                                       Style="{StaticResource AppSectionTitle}"
                                       Margin="0,32,0,12" />

                            <!-- Empty state while discovery runs. -->
                            <Border Style="{StaticResource AppCard}"
                                    Padding="{StaticResource CardPadding}">
                                <StackPanel x:Name="ScanningPanel" Visibility="Visible" Spacing="16">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE701;" FontSize="16"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  VerticalAlignment="Top" Margin="0,1,0,0" />
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource AppSecondary}"
                                                   TextWrapping="Wrap"
                                                   Text="Looking for devices on this network. Keep Link All open on the other device and both on the same Wi-Fi." />
                                    </Grid>
                                    <ProgressBar IsIndeterminate="True" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="1" Padding="40,12,40,24">
                    <Button x:Name="BtnFooterLeft" Content="Skip for now"
                            Style="{StaticResource AppSecondaryButton}"
                            HorizontalAlignment="Left"
                            Click="BtnFooterLeft_Click" />

                    <!-- Step indicator: onboarding is a single step today, so it stays hidden. -->
                    <StackPanel x:Name="PaginationPanel" Visibility="Collapsed"
                                Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="6">
                        <Ellipse x:Name="Dot0" Fill="{ThemeResource AppAccentBrush}" Width="6" Height="6" />
                        <Ellipse x:Name="Dot1" Fill="{ThemeResource AppBorderStrongBrush}" Width="6" Height="6" />
                        <Ellipse x:Name="Dot2" Fill="{ThemeResource AppBorderStrongBrush}" Width="6" Height="6" />
                        <Ellipse x:Name="Dot3" Fill="{ThemeResource AppBorderStrongBrush}" Width="6" Height="6" />
                    </StackPanel>

                    <Button x:Name="BtnFooterRight" Content="Get started"
                            Style="{StaticResource AppPrimaryButton}"
                            Padding="20,8"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed"
                            Click="BtnFooterRight_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
