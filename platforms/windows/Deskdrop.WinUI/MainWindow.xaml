<Window
    x:Class="Deskdrop.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI"
    xmlns:services="using:Deskdrop.WinUI.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Link All">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        Tray popup. A glance surface: this PC and its live state, the two
        actions you open it for, and recent activity as one grouped list.
        Anything deeper lives in the dashboard.
    -->
    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" Height="36" Grid.Row="0" Background="Transparent" />

        <!-- This PC and its live state -->
        <Grid Grid.Row="1" Padding="20,4,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                <Border Style="{StaticResource AppIconTile}"
                        Background="{ThemeResource AppAccentSubtleBrush}">
                    <FontIcon Glyph="&#xE7F4;" FontSize="16"
                              Foreground="{ThemeResource AppAccentBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Width="12" Height="12" CornerRadius="6"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,-3,-3"
                        BorderThickness="2"
                        BorderBrush="{ThemeResource AppBackgroundBrush}"
                        Background="{x:Bind local:StringToBrushConverter.ToSolidColorBrush(mgr.HeaderStatusBrush), Mode=OneWay}"
                        services:PulseEffects.EnablePulse="{x:Bind mgr.IsSearching, Mode=OneWay}" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind localMachineName, Mode=OneTime}"
                           Style="{StaticResource AppPageTitle}" />
                <TextBlock Text="{x:Bind mgr.HeaderStatusText, Mode=OneWay}"
                           Style="{StaticResource AppSecondary}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button Grid.Column="2" Style="{StaticResource AppIconButton}"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Open the Link All dashboard"
                    AutomationProperties.Name="Open the Link All dashboard"
                    Click="BtnOpenDashboard_Click">
                <FontIcon Glyph="&#xE8A7;" FontSize="15" />
            </Button>
        </Grid>

        <!-- One primary action, one supporting action -->
        <Grid Grid.Row="2" Padding="20,20,20,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource AppPrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Padding="14,8"
                    Click="SendFile_Click"
                    ToolTipService.ToolTip="Choose files to send">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE898;" FontSize="13" />
                    <TextBlock Text="Send file" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource AppSecondaryButton}"
                    HorizontalAlignment="Stretch"
                    Padding="14,8"
                    Click="PairDevice_Click"
                    ToolTipService.ToolTip="Show a pairing code for a new device">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xED14;" FontSize="13" />
                    <TextBlock Text="Pair device" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Grid.Row="3" Text="Recent"
                   Style="{StaticResource AppSectionTitle}"
                   Margin="20,24,20,10" />

        <!-- Recent activity from the live feed -->
        <Grid Grid.Row="4" Margin="20,0,20,20">
            <Border Style="{StaticResource AppGroupCard}"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind local:BoolToVisibleConverter.ToVisibility(mgr.HasRecentActivity), Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- The -1 top margin tucks the first row's hairline under the panel border. -->
                    <ItemsControl Margin="0,-1,0,0"
                                  ItemsSource="{x:Bind mgr.RecentActivity, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ActivityEntry">
                                <Grid>
                                    <Border Style="{StaticResource AppDivider}"
                                            Margin="66,0,0,0" VerticalAlignment="Top" />
                                    <Grid Padding="{StaticResource RowPadding}" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource AppIconTile}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind local:ActivityKindToGlyphConverter.ToGlyph(kind), Mode=OneWay}"
                                                      FontSize="15"
                                                      Foreground="{x:Bind local:StringToBrushConverter.ToSolidColorBrush(AccentColor), Mode=OneWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                       Style="{StaticResource AppBodyStrong}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind RelativeTime, Mode=OneWay}"
                                                       Style="{StaticResource AppSecondary}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Empty state -->
            <Border Style="{StaticResource AppCard}"
                    Padding="{StaticResource CardPadding}"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind local:BoolToVisibleConverter.ToVisibility(mgr.HasNoRecentActivity), Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE81C;" FontSize="16"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              VerticalAlignment="Top" Margin="0,1,0,0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource AppSecondary}"
                               TextWrapping="Wrap"
                               Text="Nothing recent. Transfers and clipboard syncs will show up here." />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
