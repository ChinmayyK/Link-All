<ContentDialog
    x:Class="Deskdrop.WinUI.PairDeviceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI"
    xmlns:services="using:Deskdrop.WinUI.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pair a new device"
    CloseButtonText="Done"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <!--
            Per-state colours for StatusGlyph, applied by code-behind as a
            Style. A ThemeResource setter resolves against this dialog's own
            theme; a brush looked up in code would not.
        -->
        <Style x:Key="StatusGlyphWarningStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource AppWarningBrush}" />
        </Style>
        <Style x:Key="StatusGlyphSuccessStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource AppSuccessBrush}" />
        </Style>
        <Style x:Key="StatusGlyphErrorStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource AppDangerBrush}" />
        </Style>

        <!-- One digit of the security code. -->
        <Style x:Key="PinTileStyle" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Background" Value="{ThemeResource AppSurfaceSubtleBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        </Style>
        <Style x:Key="PinDigitStyle" TargetType="TextBlock" BasedOn="{StaticResource AppMono}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>

    <!--
        Pairing sheet: the QR code, one status row, then a card per incoming
        request with the six-digit code to compare before accepting.
    -->
    <StackPanel Width="340" Spacing="16">

        <TextBlock Style="{StaticResource AppSecondary}"
                   TextWrapping="Wrap"
                   Text="Open Link All on your phone or another computer and scan this code. Nothing leaves your local network." />

        <!-- The QR needs a white quiet zone to stay scannable in either theme. -->
        <Border Background="White"
                BorderBrush="{ThemeResource AppBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusCard}"
                Padding="14"
                HorizontalAlignment="Center">
            <Grid Width="188" Height="188">
                <ProgressRing x:Name="QrLoadingRing" IsActive="True" Width="28" Height="28" />
                <Image x:Name="QrCodeImage" Stretch="Uniform" Visibility="Collapsed"
                       AutomationProperties.Name="Pairing QR code" />
                <StackPanel x:Name="QrErrorPanel" Visibility="Collapsed" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE783;" FontSize="20"
                              Foreground="#C62828" HorizontalAlignment="Center" />
                    <TextBlock Text="Couldn't reach the local service"
                               FontSize="12" Foreground="#5F6068"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Width="150" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Live status as a single list row: waiting, request received, or paired. -->
        <Border x:Name="StatusPanel" Style="{StaticResource AppGroupCard}">
            <Grid Padding="{StaticResource RowPadding}" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AppIconTile}" VerticalAlignment="Center">
                    <Grid>
                        <ProgressRing x:Name="WaitingRing" IsActive="True" Width="18" Height="18" />
                        <!-- No local Foreground: it would override the per-state Styles set in code. -->
                        <FontIcon x:Name="StatusGlyph" Glyph="&#xE73E;" FontSize="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="StatusTitle" Style="{StaticResource AppBodyStrong}"
                               Text="Waiting for a device to scan" />
                    <TextBlock x:Name="StatusDetail" Style="{StaticResource AppSecondary}"
                               TextWrapping="Wrap"
                               Text="This code stays valid while the window is open." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Incoming requests. Only present when a device has actually asked. -->
        <ItemsControl ItemsSource="{x:Bind mgr.PairingRequests, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:PeerViewModel">
                    <Border Style="{StaticResource AppCard}"
                            Padding="{StaticResource CardPadding}"
                            Margin="0,0,0,8">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AppIconTile}"
                                        Background="{ThemeResource AppAccentSubtleBrush}">
                                    <FontIcon Glyph="&#xE72E;" FontSize="16"
                                              Foreground="{ThemeResource AppAccentBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                               Style="{StaticResource AppBodyStrong}" />
                                    <TextBlock Text="Wants to pair with this PC"
                                               Style="{StaticResource AppSecondary}" />
                                </StackPanel>
                            </Grid>

                            <!-- Six digit tiles, grouped 3 + 3. -->
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Style="{StaticResource PinTileStyle}">
                                        <TextBlock Style="{StaticResource PinDigitStyle}"
                                                   Text="{x:Bind local:PairDeviceDialog.PinDigit(pairingPin, 0), Mode=OneWay}" />
                                    </Border>
                                    <Border Style="{StaticResource PinTileStyle}">
                                        <TextBlock Style="{StaticResource PinDigitStyle}"
                                                   Text="{x:Bind local:PairDeviceDialog.PinDigit(pairingPin, 1), Mode=OneWay}" />
                                    </Border>
                                    <Border Style="{StaticResource PinTileStyle}">
                                        <TextBlock Style="{StaticResource PinDigitStyle}"
                                                   Text="{x:Bind local:PairDeviceDialog.PinDigit(pairingPin, 2), Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Style="{StaticResource PinTileStyle}">
                                        <TextBlock Style="{StaticResource PinDigitStyle}"
                                                   Text="{x:Bind local:PairDeviceDialog.PinDigit(pairingPin, 3), Mode=OneWay}" />
                                    </Border>
                                    <Border Style="{StaticResource PinTileStyle}">
                                        <TextBlock Style="{StaticResource PinDigitStyle}"
                                                   Text="{x:Bind local:PairDeviceDialog.PinDigit(pairingPin, 4), Mode=OneWay}" />
                                    </Border>
                                    <Border Style="{StaticResource PinTileStyle}">
                                        <TextBlock Style="{StaticResource PinDigitStyle}"
                                                   Text="{x:Bind local:PairDeviceDialog.PinDigit(pairingPin, 5), Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Style="{StaticResource AppSecondary}"
                                       TextWrapping="Wrap"
                                       Text="{x:Bind local:PairDeviceDialog.MatchHint(DisplayName), Mode=OneWay}" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource AppSecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Content="Decline"
                                        Click="OnDeclinePairingClicked" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource AppPrimaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Content="Accept"
                                        Click="OnAcceptPairingClicked" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button x:Name="RetryButton" Style="{StaticResource AppSecondaryButton}"
                Content="Try again"
                HorizontalAlignment="Left"
                Visibility="Collapsed"
                Click="OnRetryClicked" />
    </StackPanel>
</ContentDialog>
