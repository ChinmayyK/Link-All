<ContentDialog
    x:Class="Deskdrop.WinUI.ConnectByIpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Connect by IP address"
    PrimaryButtonText="Connect"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnConnectClicked">

    <!--
        Direct connect for networks where devices can't find each other
        (guest Wi-Fi, client isolation, VPNs): type the other device's
        address, see this PC's own address to type on the other side.
    -->
    <StackPanel Width="360" Spacing="14">

        <TextBlock Style="{StaticResource AppSecondary}"
                   TextWrapping="Wrap"
                   Text="Enter the IP address shown in Link All on the other device. Both devices need to be on the same network." />

        <StackPanel Spacing="6">
            <TextBox x:Name="AddressBox"
                     PlaceholderText="192.168.1.50 or 192.168.1.50:47823"
                     IsSpellCheckEnabled="False"
                     InputScope="Url"
                     TextChanged="OnAddressChanged"
                     KeyDown="OnAddressKeyDown"
                     AutomationProperties.Name="Device address" />
            <TextBlock x:Name="ErrorText"
                       Style="{StaticResource AppCaption}"
                       Foreground="{ThemeResource AppDangerBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- Recently used addresses, one click to reconnect. -->
        <StackPanel x:Name="RecentPanel" Spacing="6" Visibility="Collapsed">
            <TextBlock Style="{StaticResource AppCaption}" Text="Recent" />
            <ItemsControl x:Name="RecentList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Style="{StaticResource AppSecondaryButton}"
                                Padding="10,4"
                                Content="{x:Bind}"
                                Click="OnRecentClicked" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Connecting / failure status. -->
        <Border x:Name="StatusPanel" Style="{StaticResource AppGroupCard}" Visibility="Collapsed">
            <Grid Padding="{StaticResource RowPadding}" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ProgressRing x:Name="ConnectingRing" IsActive="True" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1"
                           Style="{StaticResource AppSecondary}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Style="{StaticResource AppGroupCard}">
            <Grid Padding="{StaticResource RowPadding}" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource AppIconTile}"
                        Background="{ThemeResource AppAccentSubtleBrush}"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7F4;" FontSize="16"
                              Foreground="{ThemeResource AppAccentBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{StaticResource AppSecondary}" Text="This PC's address" />
                    <TextBlock x:Name="OwnAddressText"
                               Style="{StaticResource AppBodyStrong}"
                               IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</ContentDialog>
