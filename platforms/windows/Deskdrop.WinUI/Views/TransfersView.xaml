<Page
    x:Class="Deskdrop.WinUI.Views.TransfersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI.Views"
    xmlns:winui="using:Deskdrop.WinUI"
    xmlns:services="using:Deskdrop.WinUI.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Transfers, in the shared Android/Windows layout: large heading, the
        live speed test when one runs, the in-progress list, then history.
        Rows sit in grouped panels separated by hairlines; each active row
        keeps its numbers (percent, rate) on the right and a thin bar under.
    -->
    <Page.Resources>
        <DataTemplate x:Key="TransferRowTemplate" x:DataType="winui:FileTransferState">
            <Grid Padding="16,14" RowSpacing="10" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="2" Height="1" Margin="54,-14,-16,0"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AppDividerBrush}" />

                <Grid Grid.Row="0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AppIconTile}">
                        <FontIcon Glyph="{x:Bind TransferIcon, Mode=OneWay}"
                                  FontSize="18"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind FileName, Mode=OneWay}" Style="{StaticResource AppBodyStrong}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}"
                                       Style="{StaticResource AppSecondary}"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind StateColor, Converter={StaticResource StringToBrushConverter}, Mode=OneWay}" />
                            <TextBlock Text="&#183;" Style="{StaticResource AppCaption}" />
                            <TextBlock Text="{x:Bind PeerLabel, Mode=OneWay}" Style="{StaticResource AppCaption}" />
                            <TextBlock Text="&#183;" Style="{StaticResource AppCaption}" />
                            <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" Style="{StaticResource AppCaption}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,4,0"
                                    Visibility="{x:Bind ShowProgress, Converter={StaticResource BoolToVisibleConverter}, Mode=OneWay}">
                            <TextBlock Text="{x:Bind PercentText, Mode=OneWay}"
                                       Style="{StaticResource AppMono}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind RateText, Mode=OneWay}"
                                       Style="{StaticResource AppCaption}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                        <Button Style="{StaticResource AppSecondaryButton}"
                                Content="Decline"
                                Visibility="{x:Bind ShowAcceptReject, Converter={StaticResource BoolToVisibleConverter}, Mode=OneWay}"
                                Click="OnRejectClicked" />
                        <Button Style="{StaticResource AppPrimaryButton}"
                                Content="Accept"
                                Visibility="{x:Bind ShowAcceptReject, Converter={StaticResource BoolToVisibleConverter}, Mode=OneWay}"
                                Click="OnAcceptClicked" />
                        <Button Style="{StaticResource AppIconButton}"
                                Visibility="{x:Bind ShowCancel, Converter={StaticResource BoolToVisibleConverter}, Mode=OneWay}"
                                ToolTipService.ToolTip="Cancel this transfer"
                                AutomationProperties.Name="Cancel this transfer"
                                Click="OnCancelClicked">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource AppSecondaryButton}"
                                Visibility="{x:Bind ShowOpenFolder, Converter={StaticResource BoolToVisibleConverter}, Mode=OneWay}"
                                ToolTipService.ToolTip="Show the received file"
                                Click="OnOpenDestinationClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xED25;" FontSize="12" />
                                <TextBlock Text="Show" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Determinate while bytes move, indeterminate while the
                     engine verifies integrity (a percentage would be a lie). -->
                <ProgressBar Grid.Row="1"
                             Margin="54,0,0,0"
                             Value="{x:Bind PercentFloat, Mode=OneWay}"
                             Maximum="100"
                             IsIndeterminate="{x:Bind IsVerifying, Mode=OneWay}"
                             Height="3"
                             CornerRadius="1.5"
                             Foreground="{x:Bind ProgressColor, Converter={StaticResource StringToBrushConverter}, Mode=OneWay}"
                             Visibility="{x:Bind ShowProgress, Converter={StaticResource BoolToVisibleConverter}, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HistoryRowTemplate" x:DataType="winui:ActivityEntry">
            <Grid Padding="16,11" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="4" Height="1" Margin="50,-11,-16,0"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AppDividerBrush}" />
                <Border Grid.Column="0" Width="36" Height="36"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{ThemeResource AppSurfaceSubtleBrush}">
                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                              FontSize="14"
                              Foreground="{x:Bind AccentColor, Converter={StaticResource StringToBrushConverter}, Mode=OneWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource AppBodyStrong}" />
                    <TextBlock Text="{x:Bind Source, Mode=OneWay}" Style="{StaticResource AppCaption}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize, Mode=OneWay}"
                           Style="{StaticResource AppCaption}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="3" Text="{x:Bind RelativeTime, Mode=OneWay}"
                           Style="{StaticResource AppMono}" FontSize="11.5"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" MinWidth="64" TextAlignment="Right" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="24" MaxWidth="1000">

            <!-- Header -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Transfers" Style="{StaticResource AppDisplayText}" />
                    <TextBlock Style="{StaticResource AppSecondary}"
                               Text="{x:Bind mgr.TransfersSummaryText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{StaticResource AppSecondaryButton}" Padding="16,8"
                            ToolTipService.ToolTip="Open the folder received files are saved to"
                            Click="OnOpenDownloadFolderClicked">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xED25;" FontSize="13" />
                            <TextBlock Text="Downloads" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppSecondaryButton}" Padding="16,8"
                            ToolTipService.ToolTip="Choose a folder to send, with everything in it"
                            Click="OnSendFolderClicked">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                            <TextBlock Text="Send folder" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppPrimaryButton}" Padding="18,8"
                            ToolTipService.ToolTip="Choose files to send"
                            Click="OnSendFilesClicked">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE898;" FontSize="13" />
                            <TextBlock Text="Send files" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Live speed test, leading with the number it exists to produce. -->
            <ItemsControl ItemsSource="{x:Bind mgr.ActiveSpeedTests, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="winui:SpeedTestState">
                        <Border Style="{StaticResource AppCardLarge}"
                                BorderBrush="{ThemeResource AppAccentBrush}"
                                Padding="20,18"
                                Margin="0,0,0,10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Speed test" Style="{StaticResource AppBodyStrong}"
                                               Foreground="{ThemeResource AppAccentBrush}" />
                                    <TextBlock Text="{x:Bind phase, Mode=OneWay}" Style="{StaticResource AppSecondary}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind SpeedText, Mode=OneWay}"
                                           Style="{StaticResource AppDisplayText}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- In progress -->
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="In progress" Style="{StaticResource AppSectionTitle}" />
                    <TextBlock Text="{x:Bind mgr.ActiveTransferCount, Mode=OneWay}"
                               Style="{StaticResource AppSecondary}" VerticalAlignment="Center"
                               Visibility="{x:Bind mgr.HasActiveTransfers, Converter={StaticResource BoolToVisibleConverter}, Mode=OneWay}" />
                </StackPanel>

                <Border Style="{StaticResource AppCard}" Background="Transparent" Padding="20,18"
                        Visibility="{x:Bind mgr.HasActiveTransfers, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="20"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Nothing transferring" Style="{StaticResource AppBodyStrong}" />
                            <TextBlock Style="{StaticResource AppSecondary}" TextWrapping="Wrap"
                                       Text="Send files from here, drop them on the Link All window, or use the right-click menu in File Explorer." />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource AppGroupCard}"
                        Visibility="{x:Bind mgr.HasActiveTransfers, Converter={StaticResource BoolToVisibleConverter}, Mode=OneWay}">
                    <ListView Margin="0,-1,0,0"
                              SelectionMode="None"
                              Padding="0"
                              IsItemClickEnabled="False"
                              ItemContainerStyle="{StaticResource AppPlainListItem}"
                              ItemTemplate="{StaticResource TransferRowTemplate}"
                              ItemsSource="{x:Bind mgr.ActiveTransfers, Mode=OneWay}" />
                </Border>
            </StackPanel>

            <!-- History -->
            <StackPanel Spacing="10">
                <TextBlock Text="History" Style="{StaticResource AppSectionTitle}" />
                <Border Style="{StaticResource AppGroupCard}"
                        Visibility="{x:Bind mgr.TransferHistoryCount, Converter={StaticResource CountToVisibilityConverter}, Mode=OneWay}">
                    <ItemsControl Margin="0,-1,0,0"
                                  ItemsSource="{x:Bind mgr.TransferHistory, Mode=OneWay}"
                                  ItemTemplate="{StaticResource HistoryRowTemplate}" />
                </Border>
                <TextBlock Style="{StaticResource AppSecondary}"
                           Text="No completed transfers yet."
                           Visibility="{x:Bind mgr.TransferHistoryCount, Converter={StaticResource InverseCountToVisibilityConverter}, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
