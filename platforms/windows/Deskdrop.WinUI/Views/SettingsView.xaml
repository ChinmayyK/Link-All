<Page
    x:Class="Deskdrop.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Deskdrop.WinUI.Views"
    xmlns:winui="using:Deskdrop.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Windows settings pattern: a single scrolling column of labelled
        groups, each group one card of hairline-separated rows. Every row is
        icon / title / description / control, in that order, at a consistent
        52px minimum height.

        The previous page mixed 12px and 16px paddings, three heading sizes
        and a coloured icon per section, which made a short settings list feel
        like six unrelated panels.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}"
                    Spacing="28"
                    MaxWidth="860">

            <!-- Header, then this PC's identity card, as on Android. -->
            <StackPanel Spacing="20">
                <TextBlock Text="Settings" Style="{StaticResource AppDisplayText}" />
                <Border Style="{StaticResource AppGroupCard}">
                    <Grid Padding="16,14" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppAccentSubtleBrush}">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource AppAccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind DeviceName, Mode=OneWay}" Style="{StaticResource AppBodyStrong}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="7" Height="7" CornerRadius="3.5" VerticalAlignment="Center"
                                        Background="{x:Bind winui:StringToBrushConverter.ToSolidColorBrush(mgr.HeaderStatusBrush), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind mgr.DaemonStatusText, Mode=OneWay}" Style="{StaticResource AppSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ============================ GENERAL -->
            <StackPanel Spacing="8">
                <TextBlock Text="General" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE790;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Appearance" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Match Windows, or lock Link All to light or dark"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeSelector" Grid.Column="2" MinWidth="130"
                                      VerticalAlignment="Center"
                                      SelectionChanged="OnThemeSelectionChanged"
                                      AutomationProperties.Name="Appearance">
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                                <ComboBoxItem Content="Use system setting" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7E8;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Start with Windows" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Run quietly in the system tray after you sign in"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnStartupToggled"
                                          AutomationProperties.Name="Start with Windows" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="This PC's name" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="How this computer appears to your other devices"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind DeviceName, Mode=OneWay}"
                                       Style="{StaticResource AppMetric}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ DEVICES -->
            <StackPanel Spacing="8">
                <TextBlock Text="Devices and discovery" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8EA;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Paired devices" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="{x:Bind mgr.EcosystemSummaryText, Mode=OneWay}"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource AppSecondaryButton}"
                                    Content="Manage"
                                    VerticalAlignment="Center"
                                    Click="OnManageDevicesClicked" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Network discovery" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Broadcast on the local network to find nearby devices"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource AppSecondaryButton}"
                                    Content="Rescan now"
                                    VerticalAlignment="Center"
                                    Click="OnRescanClicked" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE897;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Welcome guide" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="See how to connect your first device again"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource AppSecondaryButton}"
                                    Content="Show"
                                    VerticalAlignment="Center"
                                    Click="OnReplayOnboardingClicked" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ TRANSFERS -->
            <StackPanel Spacing="8">
                <TextBlock Text="Transfers" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xED25;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Where received files are saved" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Incoming files always land in your Windows Downloads folder"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource AppSecondaryButton}"
                                    Content="Open folder"
                                    VerticalAlignment="Center"
                                    Click="OnOpenDownloadsClicked" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB9F;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Send new screenshots automatically" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Push screenshots to your connected devices as you take them"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ScreenshotSyncToggle" Grid.Column="2" MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnScreenshotSyncToggled"
                                          AutomationProperties.Name="Send new screenshots automatically" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEA8F;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Show phone notifications" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Pop up notifications from your Android phone on this PC"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="PhoneNotificationsToggle" Grid.Column="2" MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="OnPhoneNotificationsToggled"
                                          AutomationProperties.Name="Show phone notifications" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ CLIPBOARD -->
            <StackPanel Spacing="8">
                <TextBlock Text="Clipboard" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8C8;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Share clipboard automatically" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Copy on one device, paste on another, without confirming each time"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind mgr.SyncEnabled, Mode=TwoWay}" MinWidth="0"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Share clipboard automatically" />
                        </Grid>

                        <Border Height="1" Margin="54,0,16,0" Background="{ThemeResource AppDividerBrush}" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Filter sensitive clipboard content" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Block OTP codes, API keys, and passwords from automatic sync"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind mgr.OtpShieldEnabled, Mode=TwoWay}" MinWidth="0"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Filter sensitive clipboard content" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ SECURITY -->
            <StackPanel Spacing="8">
                <TextBlock Text="Security" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <!-- Encryption isn't a setting - it's a fact about how
                             this works. Stating it plainly buys more trust
                             than a toggle that can't be turned off. -->
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSuccessSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource AppSuccessBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="End-to-end encryption" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Every transfer stays on your local network and is encrypted between paired devices"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource AppChip}"
                                    Background="{ThemeResource AppSuccessSubtleBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Always on" Style="{StaticResource AppCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppSuccessBrush}" />
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE928;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Confirm a code when pairing" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Require a matching six-digit code on both devices before trusting a new one"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind mgr.RequireTofuConfirmation, Mode=TwoWay}" MinWidth="0"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Confirm a code when pairing" />
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppDangerSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource AppDangerBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Forget all devices" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Clear every pairing key on this PC. Each device will have to pair again."
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource AppDestructiveButton}"
                                    Content="Forget all"
                                    VerticalAlignment="Center"
                                    Click="OnRevokeAllClicked" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ ADVANCED -->
            <StackPanel Spacing="8">
                <TextBlock Text="Advanced" Style="{StaticResource AppSectionTitle}" />

                <Border Style="{StaticResource AppGroupCard}">
                    <StackPanel>
                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Local service" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="The background engine that talks to your other devices"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Style="{StaticResource AppChip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="7" Height="7" CornerRadius="4"
                                                VerticalAlignment="Center"
                                                Background="{x:Bind winui:StringToBrushConverter.ToSolidColorBrush(mgr.HeaderStatusBrush), Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind mgr.DaemonStatusText, Mode=OneWay}"
                                                   Style="{StaticResource AppCaption}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource AppSecondaryButton}"
                                        Content="View logs"
                                        Click="OnViewLogsClicked" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource AppDivider}" Margin="70,0,0,0" />

                        <Grid Padding="16,12" MinHeight="60" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource AppIconTile}" Background="{ThemeResource AppSurfaceSubtleBrush}" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Link All for Windows" Style="{StaticResource AppBodyStrong}" />
                                <TextBlock Text="Version 4.0.0  &#183;  No cloud, no account, no telemetry"
                                           Style="{StaticResource AppSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
