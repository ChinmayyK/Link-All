# Rust build artifacts
target/
**/*.rs.bk
# Cargo.lock is committed for this workspace to ensure reproducible CI builds

# macOS
.DS_Store
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
platforms/macos/build/

# Windows
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
platforms/windows/**/bin/
platforms/windows/**/obj/
platforms/windows/**/linkall_core.dll
*.msi
*.wixpdb

# Allow Rust source bins under linkall-core
!linkall-core/src/bin/
!linkall-core/src/bin/**

# Android
*.apk
*.aab
*.ap_
*.dex
platforms/android/.gradle/
platforms/android/**/build/
platforms/android/app/build/
platforms/android/benchmark/build/
platforms/android/local.properties
*.hprof

# Linux
*.deb
*.rpm

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Secrets / keys - never commit these
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
trust.json
settings.json

# Diagnostics / Bugreports
bugreport-*.zip

# Logs
*.log
proxiboard-*.log

# Benchmark HTML output (large)
target/criterion/

# Heap profiling output (generated by the dhat allocation bench)
dhat-heap.json

# SBOM output (generated by CI)
bom.json

.cargo/*
# Shared build flags (hardware crypto on arm64) must reach CI and release builds.
!.cargo/config.toml

# Build & release output — produced by CI and the local build scripts.
# Never commit these: they go stale, and a tracked .pdb leaks local build paths.
release/
build/
/liblinkall_core.dylib

# Swift macro plugins pulled from a local Xcode install for CLT-only builds —
# Apple-proprietary binaries, must never be committed.
/.build-tools/

# cargo-ndk copies dependency cdylibs next to the core; only liblinkall_core.so ships
platforms/android/app/src/main/jniLibs/**/libandroid_native_keyring_store-*.so
